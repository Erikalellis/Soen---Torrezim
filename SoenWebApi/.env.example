# Porta do servidor
PORT=3000

# Chave de API (deixe vazio para desabilitar autenticacao)
API_KEY=

# Nome do bot (usado nas respostas)
BOT_NAME=Meu Bot

# Reset do modo humano apos N horas
HUMAN_RESET_HOURS=24

# Limpeza automatica de mensagens antigas (minutos)
MESSAGE_TTL_MINUTES=60

# Limite de mensagens retornadas por paginacao
MAX_MESSAGES=500

# Rate limit (requisicoes por janela)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Chrome path (deixe vazio para auto-detect)
CHROME_PATH=

# Webhook (opcional)
WEBHOOK_SECRET=

# JWT secret (opcional - usado para tokens de instancia).
# NAO use o valor padrao: gere um aleatorio se implementar autenticacao por JWT.
JWT_SECRET=

# IA: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# IA: Ollama
AI_PROVIDER=openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# S3/MinIO (opcional)
S3_ENDPOINT=
S3_PORT=443
S3_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zap-media

# Message Queue (opcional)
MQ_RABBITMQ=
MQ_KAFKA_BROKERS=
MQ_KAFKA_TOPIC=zap-events
MQ_SQS_QUEUE_URL=
MQ_SQS_REGION=us-east-1
